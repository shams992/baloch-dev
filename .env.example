# Frontend (safe to expose). Vite bakes these in at BUILD time.
# On Vercel: Settings → Environment Variables → add both, then Redeploy.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Never put the service role key in VITE_ variables or frontend code.
# Set the following as Supabase Edge Function secrets (Dashboard → Edge Functions → Secrets).

# Email (Resend)
# RESEND_API_KEY=
# RESEND_FROM=Baloch Export Hub <noreply@yourdomain.com>
# PUBLIC_SITE_URL=https://your-frontend-domain

# WhatsApp — Twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# WhatsApp — Meta Cloud API
# META_WHATSAPP_TOKEN=
# META_WHATSAPP_PHONE_ID=

# Bank transfer copy shown by payment-providers function
# BANK_TRANSFER_INSTRUCTIONS=

# Easypaisa merchant (server-only)
# EASYPAISA_MERCHANT_ID=
# EASYPAISA_STORE_ID=
# EASYPAISA_HASH_KEY=

# JazzCash merchant (server-only)
# JAZZCASH_MERCHANT_ID=
# JAZZCASH_PASSWORD=
# JAZZCASH_INTEGERITY_SALT=

# SadaPay merchant (server-only)
# SADAPAY_MERCHANT_ID=
# SADAPAY_API_KEY=
